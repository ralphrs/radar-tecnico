{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "news",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "lookout", "database_id": "b83811df-f894-41b0-8d3b-4323faf1e1ff" }
  ],
  // Importa o histórico em partes, uma por minuto, até terminar. Depois vira uma leitura por minuto e nada mais.
  "triggers": { "crons": ["* * * * *"] },
  // ADMIN_EMAIL, ACCESS_TEAM_DOMAIN e ACCESS_AUD ficam nas variáveis do painel do Cloudflare (não no repositório).
  // CARTEIRA_KEY (secret): chave AES-GCM da Minha carteira, base64 de 32 bytes. Gere com `openssl rand -base64 32` e
  // cole no painel (Variables and Secrets, tipo Secret). Sem ela /api/carteira responde 503 "carteira desligada".
  // Trocar a chave deixa ilegível o que já foi gravado: as pessoas teriam de apagar e importar de novo.
  "keep_vars": true,
  // Sem Smart Placement: o Worker roda na borda, perto de quem acessa, e lê do espelho em São Paulo
  // (Durable Object abaixo, src/espelho.js). O D1, no leste dos EUA, só entra nas gravações e quando o espelho falha.
  //
  // ESPELHO_ATIVO = "0" manda todas as leituras de volta ao D1. Dá para trocar no painel (Variables and Secrets)
  // sem deploy; o próximo deploy volta ao valor daqui.
  "vars": { "ESPELHO_ATIVO": "1" },
  "durable_objects": {
    "bindings": [{ "name": "ESPELHO", "class_name": "Espelho" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Espelho"] }],
  "observability": { "enabled": true }
}
